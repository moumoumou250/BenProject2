# Grok Build — 复制到仓库根 .env，或合并进已有配置
# 前置：grok login（~/.grok/auth.json）；勿把 OAuth token 配到 api.x.ai

BEN_ENGINE=auto
BEN_MODEL=grok
# BEN_MODEL=grok/grok-4.6

# 不要填 BEN_API_KEY / BEN_API_BASE（订阅路由忽略它们）
# xai API key 路由请改用：BEN_MODEL=xai/grok-4.6 + BEN_API_KEY=xai-... + BEN_API_BASE=https://api.x.ai/v1
