# cp .env.example .env && ben config --check
# 详见 examples/grok/

# ═══════════════ main_model（主模型）═══════════════
# commander / 默认决策脑。三选一：Grok Build | 单 key | 见下方 rotation 首条
BEN_ENGINE=auto
BEN_MODEL=grok
# BEN_MODEL=grok/grok-4.6

# 非 Grok Build 时给主模型填网关（Grok 订阅勿填）
# BEN_API_KEY=sk-xxxxxxxx
# BEN_API_BASE=https://your-gateway.example.com/v1
# OPENAI_API_KEY=
# OPENAI_BASE_URL=

# ═══════════════ flash（子模型）═══════════════
# fleet worker / BEN_WORKER 自动用；不配则与主模型相同
# BEN_FLASH_MODEL=kimi-k2.6
# BEN_FLASH_API_KEY=sk-xxxxxxxx
# BEN_FLASH_API_BASE=https://api.moonshot.cn/v1

# ═══════════════ rotation（轮换模型）═══════════════
# 仅用于主模型 API key 限流/欠费时环形切换；Grok Build 订阅不用
# 第一条可当主模型种子（未设 BEN_API_KEY 时采用）
# BEN_KEY_POOL=[
#   {"api_key": "sk-a", "api_base": "https://gw-a.example.com/v1", "model": "glm-5.3"},
#   {"api_key": "sk-b", "api_base": "https://gw-b.example.com/v1", "model": "glm-5.3"}
# ]

# ═══════════════ cli 回落 ═══════════════
# ANTHROPIC_BASE_URL=
# ANTHROPIC_AUTH_TOKEN=

# ═══════════════ 可选 ═══════════════
# BEN_BIN=claude
# BEN_TIMEOUT=600
# BEN_RETRY_MODEL=0
# BEN_MAX_TURNS=40
# BEN_CONTEXT_CHARS=400000
# BEN_TOOL_TIMEOUT=180
# BEN_FS_ROOTS=cwd:/tmp
# BEN_PYTHON=python3
# BEN_RUNTIME_DIR=runs
#   ^ 运行时输出根目录（注册表/日志/console/socket/HTML 快照），相对项目根。
#     所有生成物只进这一个目录，见 docs/ARCH.md §运行时输出。CI 里指到临时目录即可。
# BEN_KB_ROOT=
# BEN_WORKER=
# BEN_ENV_FILE=
# FGC_SENDER=ben-agent
# AI_SEND_INITIAL_DELAY=0.1
# AI_SEND_SUBMIT_DELAY=0.5
# BENCHMARK_BASE_URL=
# BENCHMARK_TOKEN=
# EDITOR=vim
# VISUAL=vim
